---
interface Props {
  sectorSlug: string;
  ciudadSlug: string;
  sectorName: string;
  ciudadName: string;
  image: string;
}

const { sectorSlug, ciudadSlug, sectorName, ciudadName, image } = Astro.props;
---

<article class="bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 overflow-hidden flex flex-col">
  <div class="relative h-40">
    <img src={image} alt={`${sectorName} en ${ciudadName}`} class="w-full h-full object-cover" loading="lazy" />
    <button class="absolute top-3 right-3 w-8 h-8 bg-white/90 rounded-full flex items-center justify-center text-gray-400 hover:text-red-500 transition-colors shadow-sm" aria-label="Guardar oportunidad">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" /></svg>
    </button>
  </div>
  <div class="p-5 flex-grow flex flex-col">
    <h3 class="font-bold text-gray-900 text-lg mb-2">{sectorName} en {ciudadName}</h3>
    <div class="text-sm text-gray-600 mb-4 space-y-1">
      <p><span class="font-semibold text-gray-900">{ciudadName}</span></p>
      <p class="flex items-center"><span class="w-2 h-2 rounded-full bg-green-500 mr-2"></span> Demanda alta</p>
      <p class="flex items-center"><span class="w-2 h-2 rounded-full bg-yellow-400 mr-2"></span> Competencia media</p>
    </div>
    <div class="mt-auto">
      <a href={`/sectores/${sectorSlug}-${ciudadSlug}`} class="block w-full text-center px-4 py-2 bg-gray-50 hover:bg-primary hover:text-white border border-gray-200 hover:border-primary rounded-md text-sm font-medium text-gray-700 transition-colors">
        Ver oportunidad
      </a>
    </div>
  </div>
</article>
