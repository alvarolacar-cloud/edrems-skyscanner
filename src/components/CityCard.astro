---
interface Props {
  slug: string;
  name: string;
  image: string;
  desc: string;
}

const { slug, name, image, desc } = Astro.props;
---

<a href={`/ciudades/${slug}`} class="group relative block w-full h-64 rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300">
  <img src={image} alt={`Ciudad ${name}`} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" loading="lazy" />
  <div class="absolute inset-0 bg-gradient-to-t from-dark/90 via-dark/40 to-transparent"></div>
  <div class="absolute bottom-0 left-0 right-0 p-6">
    <h3 class="text-2xl font-bold text-white mb-1 group-hover:text-primary transition-colors">{name}</h3>
    <p class="text-sm text-gray-300">{desc}</p>
  </div>
</a>
