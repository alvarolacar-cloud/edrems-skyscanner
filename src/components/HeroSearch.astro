---
import { sectores, ciudades } from '../data/content';
---

<section class="relative bg-dark-light pt-20 pb-24 overflow-hidden">
  <!-- Background Pattern / Image -->
  <div class="absolute inset-0 opacity-20 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1552664730-d307ca884978?q=80&w=2000&auto=format&fit=crop');"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-dark to-dark/80"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <h1 class="text-4xl md:text-5xl font-extrabold text-white leading-tight tracking-tight mb-4">
        Clientes que te buscan,<br/>clientes que te eligen
      </h1>
      <p class="text-xl text-gray-300">
        Aparece primero en Google y Google Maps cuando tus clientes necesitan tus servicios y recibe más llamadas cada día.
      </p>
    </div>

    <!-- Booking/eDreams Style Search Engine -->
    <div class="bg-primary p-1 md:p-2 rounded-xl shadow-2xl max-w-4xl mx-auto">
      <form id="hero-search-form" class="bg-white rounded-lg p-4 md:p-6 flex flex-col md:flex-row items-end gap-4 relative z-10">

        <div class="flex-grow w-full">
          <label for="sector-input" class="block text-sm font-bold text-gray-700 mb-1">¿Qué servicio ofreces?</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <input
              type="text"
              id="sector-input"
              list="sectores-list"
              class="block w-full pl-10 pr-3 py-3 border-2 border-gray-200 rounded-md leading-5 bg-white placeholder-gray-400 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary text-gray-900 font-medium transition-colors"
              placeholder="Ej: Fontaneros"
              required
            />
            <datalist id="sectores-list">
              {sectores.map(s => <option value={s.name} data-slug={s.slug}></option>)}
            </datalist>
          </div>
        </div>

        <div class="flex-grow w-full">
          <label for="ciudad-input" class="block text-sm font-bold text-gray-700 mb-1">¿En qué ciudad?</label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <input
              type="text"
              id="ciudad-input"
              list="ciudades-list"
              class="block w-full pl-10 pr-3 py-3 border-2 border-gray-200 rounded-md leading-5 bg-white placeholder-gray-400 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary text-gray-900 font-medium transition-colors"
              placeholder="Ej: Madrid"
              required
            />
            <datalist id="ciudades-list">
              {ciudades.map(c => <option value={c.name} data-slug={c.slug}></option>)}
            </datalist>
          </div>
        </div>

        <div class="w-full md:w-auto">
          <button type="submit" class="w-full md:w-auto bg-primary hover:bg-primary-dark text-white font-bold py-3 px-8 rounded-md shadow-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors text-lg flex items-center justify-center h-[52px]">
            Ver oportunidades
          </button>
        </div>
      </form>

      <div id="search-error" class="hidden text-white bg-red-600/90 text-sm font-medium py-2 px-4 rounded-b-lg text-center">
        Por favor, selecciona un sector y una ciudad de la lista.
      </div>
    </div>

    <div class="flex flex-wrap justify-center gap-6 mt-12 text-sm text-gray-300 font-medium">
      <div class="flex items-center"><svg class="h-5 w-5 text-primary mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg> Aparece en Google Maps</div>
      <div class="flex items-center"><svg class="h-5 w-5 text-primary mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg> Más contactos reales</div>
      <div class="flex items-center"><svg class="h-5 w-5 text-primary mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg> Resultados medibles</div>
      <div class="flex items-center"><svg class="h-5 w-5 text-primary mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg> Sin permanencia</div>
    </div>
  </div>
</section>

<script>
  // Simple normalization function
  const normalize = (str: string) => str.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('hero-search-form');
    const sectorInput = document.getElementById('sector-input') as HTMLInputElement;
    const ciudadInput = document.getElementById('ciudad-input') as HTMLInputElement;
    const errorDiv = document.getElementById('search-error');

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        // Find slugs based on input value matching datalist options exactly,
        // or by a loose text match if they didn't click the autocomplete.
        const sectorVal = normalize(sectorInput.value);
        const ciudadVal = normalize(ciudadInput.value);

        const sectorOptions = Array.from(document.querySelectorAll('#sectores-list option'));
        const ciudadOptions = Array.from(document.querySelectorAll('#ciudades-list option'));

        const sectorOption = sectorOptions.find(opt => normalize((opt as HTMLOptionElement).value) === sectorVal);
        const ciudadOption = ciudadOptions.find(opt => normalize((opt as HTMLOptionElement).value) === ciudadVal);

        if (sectorOption && ciudadOption) {
          const sectorSlug = sectorOption.getAttribute('data-slug');
          const ciudadSlug = ciudadOption.getAttribute('data-slug');

          if (sectorSlug && ciudadSlug) {
             window.location.href = `/sectores/${sectorSlug}-${ciudadSlug}`;
             return;
          }
        }

        // Error state: Didn't match our lists
        if (errorDiv) {
          errorDiv.classList.remove('hidden');
          setTimeout(() => errorDiv.classList.add('hidden'), 4000);
        }
      });
    }
  });
</script>
