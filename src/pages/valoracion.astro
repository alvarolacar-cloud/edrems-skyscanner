---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Solicita tu Valoración - LocalRank"
  description="Pide una valoración gratuita para tu negocio y descubre el potencial de clientes que estás perdiendo en tu ciudad."
>
  <div class="min-h-[80vh] bg-gray-50 flex flex-col justify-center py-16">
    <div class="max-w-3xl mx-auto px-4 w-full">
      <div class="bg-white rounded-2xl shadow-xl overflow-hidden">

        <div class="bg-dark p-8 md:p-10 text-center text-white">
          <h1 class="text-3xl md:text-4xl font-extrabold mb-4">Valoración Gratuita</h1>
          <p class="text-lg text-gray-300">Descubre cuántos clientes buscan tus servicios en tu ciudad y cómo podemos ayudarte a captarlos.</p>
        </div>

        <div class="p-8 md:p-10">
          <form class="space-y-6" onsubmit="event.preventDefault(); alert('Formulario enviado correctamente. Nos pondremos en contacto pronto.'); window.location.href='/';">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2" for="nombre">Tu nombre</label>
                <input id="nombre" type="text" required class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-colors" placeholder="Ej: Laura García" />
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2" for="empresa">Nombre de tu empresa</label>
                <input id="empresa" type="text" required class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-colors" placeholder="Ej: Fontanería García" />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2" for="telefono">Teléfono</label>
                <input id="telefono" type="tel" required class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-colors" placeholder="Ej: 600 000 000" />
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2" for="email">Email</label>
                <input id="email" type="email" required class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-colors" placeholder="Ej: hola@empresa.com" />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2" for="sector">Sector</label>
                <input id="sector" type="text" required class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-colors" placeholder="Ej: Reformas" />
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2" for="ciudad">Ciudad</label>
                <input id="ciudad" type="text" required class="w-full px-4 py-3 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-colors" placeholder="Ej: Valencia" />
              </div>
            </div>

            <div>
              <label class="flex items-start">
                <input type="checkbox" required class="mt-1 h-4 w-4 text-primary border-gray-300 rounded focus:ring-primary" />
                <span class="ml-2 text-sm text-gray-600">
                  He leído y acepto la <a href="/privacidad" class="text-primary hover:underline">Política de Privacidad</a>.
                </span>
              </label>
            </div>

            <button type="submit" class="w-full flex justify-center py-4 px-4 border border-transparent rounded-md shadow-md text-lg font-bold text-white bg-primary hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors">
              Solicitar Análisis Gratuito
            </button>

          </form>

          <div class="mt-8 text-center text-sm text-gray-500">
            <p>Sin permanencia ni compromiso. 100% gratuito.</p>
            <p class="mt-2">¿Prefieres llamarnos? <strong class="text-gray-900 font-bold">900 920 252</strong></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
