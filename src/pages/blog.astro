---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Blog - LocalRank"
  description="Próximamente: Artículos y recursos sobre SEO Local, captación de clientes y marketing digital para negocios locales."
>
  <div class="min-h-[70vh] flex flex-col items-center justify-center bg-gray-50 px-4">
    <div class="text-center">
      <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-primary/10 text-primary mb-8">
        <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
      </div>
      <h1 class="text-4xl font-extrabold text-gray-900 mb-4">Próximamente</h1>
      <p class="text-xl text-gray-600 mb-8 max-w-lg mx-auto">
        Estamos preparando los mejores contenidos y guías sobre SEO local y captación de clientes para tu negocio.
      </p>
      <a href="/" class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-primary hover:bg-primary-dark transition-colors">
        Volver al inicio
      </a>
    </div>
  </div>
</Layout>
