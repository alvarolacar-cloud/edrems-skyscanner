---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'LocalRank - Tu Presencia Digital Local. Especialistas en SEO local para tu sector en tu ciudad.' } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-gray-50 text-gray-800 antialiased font-sans">
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Top bar -->
        <div class="hidden sm:flex justify-end items-center py-2 text-xs text-gray-500 space-x-4 border-b border-gray-100">
          <a href="/como-funciona" class="hover:text-primary transition-colors">Ayuda</a>
          <span>Castellano</span>
          <span class="font-medium text-gray-700">Tlf: 900 920 252</span>
        </div>

        <!-- Main Navigation -->
        <div class="flex justify-between items-center h-16">
          <div class="flex-shrink-0 flex items-center">
            <a href="/" class="flex flex-col">
              <span class="text-xl font-bold text-dark leading-none">LocalRank</span>
              <span class="text-[10px] text-gray-500 font-medium uppercase tracking-wider mt-0.5">Tu Presencia Digital Local</span>
            </a>
          </div>

          <nav class="hidden md:flex space-x-8">
            <a href="/sectores" class="text-sm font-medium text-gray-700 hover:text-primary transition-colors">Sectores</a>
            <a href="/ciudades" class="text-sm font-medium text-gray-700 hover:text-primary transition-colors">Ciudades</a>
            <a href="/casos-exito" class="text-sm font-medium text-gray-700 hover:text-primary transition-colors">Casos de éxito</a>
            <a href="/como-funciona" class="text-sm font-medium text-gray-700 hover:text-primary transition-colors">Cómo funciona</a>
          </nav>

          <div class="flex items-center space-x-3">
            <a href="/valoracion" class="hidden md:inline-flex items-center justify-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 transition-colors">
              Mi valoración
            </a>
            <a href="/valoracion" class="inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-primary hover:bg-primary-dark shadow-sm transition-colors">
              ¿Te llamamos?
            </a>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-dark text-white pt-12 pb-8 border-t-4 border-primary">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">

          <div>
            <h3 class="text-lg font-bold mb-4 text-white">Preguntas frecuentes</h3>
            <ul class="space-y-3">
              <li>
                <details class="group cursor-pointer">
                  <summary class="text-sm text-gray-300 hover:text-white font-medium list-none flex items-center justify-between">
                    ¿Qué incluye la valoración?
                    <span class="transition group-open:rotate-180">
                      <svg fill="none" height="20" width="20" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path></svg>
                    </span>
                  </summary>
                  <p class="text-sm text-gray-400 mt-2 pl-2 border-l-2 border-primary">Una revisión inicial de tu presencia local y oportunidades de mejora.</p>
                </details>
              </li>
              <li>
                <details class="group cursor-pointer">
                  <summary class="text-sm text-gray-300 hover:text-white font-medium list-none flex items-center justify-between">
                    ¿Cuánto tiempo tarda en ver resultados?
                    <span class="transition group-open:rotate-180">
                      <svg fill="none" height="20" width="20" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path></svg>
                    </span>
                  </summary>
                  <p class="text-sm text-gray-400 mt-2 pl-2 border-l-2 border-primary">Depende del sector, pero medimos contactos y visibilidad desde el inicio.</p>
                </details>
              </li>
              <li>
                <details class="group cursor-pointer">
                  <summary class="text-sm text-gray-300 hover:text-white font-medium list-none flex items-center justify-between">
                    ¿Hay permanencia?
                    <span class="transition group-open:rotate-180">
                      <svg fill="none" height="20" width="20" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path></svg>
                    </span>
                  </summary>
                  <p class="text-sm text-gray-400 mt-2 pl-2 border-l-2 border-primary">La valoración es gratuita y sin compromiso.</p>
                </details>
              </li>
            </ul>
            <a href="/como-funciona" class="inline-block mt-4 text-sm text-primary hover:text-white transition-colors">Ver todas las preguntas →</a>
          </div>

          <div>
            <h3 class="text-lg font-bold mb-4 text-white">Servicios</h3>
            <ul class="space-y-2">
              <li><a href="/sectores" class="text-sm text-gray-400 hover:text-white transition-colors">Presencia Digital Local</a></li>
              <li><a href="/sectores" class="text-sm text-gray-400 hover:text-white transition-colors">Ficha Google Maps</a></li>
              <li><a href="/sectores" class="text-sm text-gray-400 hover:text-white transition-colors">Web local profesional</a></li>
              <li><a href="/sectores" class="text-sm text-gray-400 hover:text-white transition-colors">Redes sociales locales</a></li>
              <li><a href="/como-funciona" class="text-sm text-gray-400 hover:text-white transition-colors">Citas y autoridad</a></li>
              <li><a href="/valoracion" class="text-sm text-gray-400 hover:text-white transition-colors">Plan de captación</a></li>
            </ul>
          </div>

          <div>
            <h3 class="text-lg font-bold mb-4 text-white">Empresa</h3>
            <ul class="space-y-2">
              <li><a href="/como-funciona" class="text-sm text-gray-400 hover:text-white transition-colors">Cómo funciona</a></li>
              <li><a href="/casos-exito" class="text-sm text-gray-400 hover:text-white transition-colors">Casos de éxito</a></li>
              <li><a href="/sectores" class="text-sm text-gray-400 hover:text-white transition-colors">Sectores</a></li>
              <li><a href="/ciudades" class="text-sm text-gray-400 hover:text-white transition-colors">Ciudades</a></li>
              <li><a href="/blog" class="text-sm text-gray-400 hover:text-white transition-colors">Blog</a></li>
              <li><a href="/valoracion" class="text-sm text-gray-400 hover:text-white transition-colors">Contacto</a></li>
            </ul>
          </div>

          <div class="bg-dark-light p-6 rounded-lg text-center md:text-left">
            <h3 class="text-2xl font-bold text-white mb-2">900 920 252</h3>
            <p class="text-sm text-gray-400 mb-6">Lunes a viernes de 9:00 a 18:00</p>
            <a href="/valoracion" class="block w-full text-center px-4 py-2 border border-transparent text-sm font-bold rounded-md text-dark bg-primary hover:bg-white transition-colors">
              Solicita tu valoración
            </a>
            <div class="mt-6 flex justify-center md:justify-start space-x-4">
              <!-- Social Icons (SVG) -->
              <a href="#" class="text-gray-400 hover:text-white" aria-label="Facebook">
                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" /></svg>
              </a>
              <a href="#" class="text-gray-400 hover:text-white" aria-label="Instagram">
                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" /></svg>
              </a>
              <a href="#" class="text-gray-400 hover:text-white" aria-label="X (Twitter)">
                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a href="#" class="text-gray-400 hover:text-white" aria-label="LinkedIn">
                <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" /></svg>
              </a>
            </div>
          </div>
        </div>

        <div class="border-t border-gray-800 pt-8 mt-8 flex flex-col md:flex-row justify-between items-center text-sm text-gray-500">
          <div class="flex items-center space-x-2 mb-4 md:mb-0">
            <span class="font-bold text-gray-400">LocalRank</span>
            <span>&copy; {new Date().getFullYear()} Tu Presencia Digital Local</span>
          </div>
          <div class="flex space-x-6">
            <a href="/aviso-legal" class="hover:text-white transition-colors">Aviso legal</a>
            <a href="/privacidad" class="hover:text-white transition-colors">Política de privacidad</a>
            <a href="/cookies" class="hover:text-white transition-colors">Cookies</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
